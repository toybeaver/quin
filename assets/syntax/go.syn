# Go — quin syntax definition.

name          go
extensions    go
line-comment  //
block-comment /* */
indent        tabs
auto-pairs    () [] {} "" '' ``


# Definitions: listed before the keyword lists so the name capture wins the tie.
match keyword      \b(?:func)\s+(?:\([^)]*\)\s*)?([A-Za-z_]\w*)   1:function
match keyword      \b(?:type)\s+([A-Za-z_]\w*)                    1:type

keywords keyword.control  if else for range switch case default break continue return goto fallthrough select go defer
keywords keyword          package import func var const type struct interface map chan
keywords type.builtin     bool byte rune string int int8 int16 int32 int64 uint uint8 uint16 uint32 uint64 uintptr float32 float64 complex64 complex128 error any comparable
keywords constant.builtin true false nil iota
keywords function.builtin append cap clear close complex copy delete imag len make max min new panic print println real recover

# Comments
region comment  //  $
  match comment.todo  \b(?:TODO|FIXME|XXX|NOTE)\b
region comment  /\*  \*/
  match comment.todo  \b(?:TODO|FIXME|XXX|NOTE)\b

# Strings and runes
region string  '"'  '"|$'
  match string.escape   \\(?:[\\'"abfnrtv]|[0-7]{3}|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})
  match string.special  '%[-+ #0]*(?:\d+|\*)?(?:\.(?:\d+|\*))?[vTtbcdoOqxXUeEfFgGsp%]'
region string  `  `
match char  "'(?:[^'\\]|\\.|\\x[0-9a-fA-F]{2}|\\u[0-9a-fA-F]{4})'"

# Numbers
match number  \b0[xX][0-9a-fA-F_]+\b
match number  \b0[oO]?[0-7_]+\b
match number  \b0[bB][01_]+\b
match number  \b\d[\d_]*(?:\.[\d_]*)?(?:[eE][+-]?\d+)?i?\b
match number  \B\.\d[\d_]*(?:[eE][+-]?\d+)?i?\b

# Definitions, calls, types, operators
match punctuation  \b([A-Za-z_]\w*)\s*\(                          1:function
match type         \b[A-Z][A-Za-z0-9_]*\b
match operator     :=|<-|\.\.\.|<<=?|>>=?|&\^=?|&&|\|\||\+\+|--|[-+*/%=<>!&|^]+
