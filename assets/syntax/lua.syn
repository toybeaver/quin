# Lua — quin syntax definition.

name          lua
extensions    lua
shebang       lua
line-comment  --
block-comment --[[ ]]
indent        2 spaces
auto-pairs    () [] {} "" ''

# Definitions: listed before the keyword lists so the name capture wins the tie.
match keyword      \b(?:function)\s+([A-Za-z_][\w.:]*)   1:function

keywords keyword.control  if then elseif else for while repeat until do end break return goto in
keywords keyword          function local and or not
keywords constant.builtin true false nil
keywords variable.builtin self _G _ENV _VERSION arg
keywords function.builtin print pairs ipairs next type tostring tonumber require pcall xpcall error assert select rawget rawset rawequal rawlen setmetatable getmetatable unpack load loadstring dofile collectgarbage

# Comments (block comments first: they start with the same `--`)
region comment  --\[=*\[  \]=*\]
  match comment.todo  \b(?:TODO|FIXME|XXX|NOTE)\b
region comment  --  $
  match comment.todo  \b(?:TODO|FIXME|XXX|NOTE)\b

# Strings
region string  \[=*\[  \]=*\]
region string  '"'  '"|$'
  match string.escape  \\(?:[abfnrtvz\\"']|\d{1,3}|x[0-9a-fA-F]{2}|u\{[0-9a-fA-F]+\})
region string  "'"  "'|$"
  match string.escape  \\(?:[abfnrtvz\\"']|\d{1,3}|x[0-9a-fA-F]{2}|u\{[0-9a-fA-F]+\})

# Numbers
match number  \b0[xX][0-9a-fA-F]+(?:\.[0-9a-fA-F]*)?(?:[pP][+-]?\d+)?\b
match number  \b\d+(?:\.\d*)?(?:[eE][+-]?\d+)?\b
match number  \B\.\d+(?:[eE][+-]?\d+)?\b

# Definitions, calls, operators
match punctuation  \b([A-Za-z_]\w*)\s*[({]              1:function
match namespace    \b(string|table|math|io|os|coroutine|debug|utf8|package)\.   1:namespace
match operator     \.\.\.?|==|~=|<=|>=|//|<<|>>|[-+*/%^#<>=&|~]
