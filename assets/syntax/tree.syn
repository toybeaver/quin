# The file tree sidebar (`:tree`): one entry per line, directories end with `/`.

name          tree
indent        2 spaces

# A `* ` marker in front of a directory means git sees changes inside it.
match tree.modified  '^\s*(\* )?([^/]+/)$'   2:directory
match tree.hidden  ^\s*\.[^/]*$
match tree.hidden  ^\s*\.[^/]*/$
